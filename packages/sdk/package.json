{
  "name": "@lumenpass/sdk",
  "version": "0.2.0",
  "description": "Official TypeScript SDK for interacting with LumenPass.",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "dev": "tsup --watch",
    "build": "tsup",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "lumenpass",
    "stellar",
    "soroban",
    "membership",
    "access-control",
    "sdk",
    "typescript"
  ],
  "author": "LumenPass",
  "license": "MIT",
  "sideEffects": false,
  "dependencies": {
    "@lumenpass/core": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "tsup": "^8.0.0",
    "typescript": "^5.9.0",
    "vitest": "^3.0.0"
  }
}
